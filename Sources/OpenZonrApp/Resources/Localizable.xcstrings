    "statusWindow.accessibility.degraded": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the insidious case: macOS reports trust but delivers no real windows. Every app answers AXWindows with only a stand-in of role AXApplication. Relying on AXIsProcessTrusted() silently does nothing in this situation."
          }
        }
      }
    },
    "statusWindow.accessibility.degraded.step1": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings → Privacy & Security → Accessibility."
          }
        }
      }
    },
    "statusWindow.accessibility.degraded.step2": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the existing entry for OpenZonr — merely re-checking the box is not enough."
          }
        }
      }
    },
    "statusWindow.accessibility.degraded.step3": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the same bundle again and enable it — the path is below under “Code Signature”; a second copy elsewhere does not help."
          }
        }
      }
    },
    "statusWindow.accessibility.degraded.step4": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the state reappears afterwards, the signature is almost always the cause — see below."
          }
        }
      }
    },
    "statusWindow.accessibility.granted": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access works: at least one app delivers a real window with a readable position. That is the check that counts — AXIsProcessTrusted() alone does not predict it."
          }
        }
      }
    },
    "statusWindow.accessibility.inconclusive": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ordinary app was reachable to check access against. Open any program with a window and check again."
          }
        }
      }
    },
    "statusWindow.accessibility.notTrusted": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenZonr is not on the list of programs allowed to use Accessibility. Without that entry, no tool can read or move a window."
          }
        }
      }
    },
    "statusWindow.accessibility.notTrusted.step1": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click “Request Permission” — macOS then shows the system dialog once."
          }
        }
      }
    },
    "statusWindow.accessibility.notTrusted.step2": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If no dialog appears: open System Settings → Privacy & Security → Accessibility."
          }
        }
      }
    },
    "statusWindow.accessibility.notTrusted.step3": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click “+” there and add exactly this bundle — the path is below under “Code Signature”. “Show in Finder” has it ready to drag in."
          }
        }
      }
    },
    "statusWindow.accessibility.notTrusted.step4": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the switch on. OpenZonr then checks again on its own."
          }
        }
      }
    },
