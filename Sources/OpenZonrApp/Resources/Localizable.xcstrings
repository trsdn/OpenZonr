        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login item could not be %@: %@\n\nMost common reason: the bundle is not signed, or it sits in a place launchd does not accept. Scripts/bundle.sh signs it; the login item additionally needs the app in /Applications."
          }
        }
